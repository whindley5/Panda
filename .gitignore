# Real documents never belong in this repository. Keep them outside it, or in one of
# these folders, which git ignores.
/input/
/test_docs/
/output/
/reports/
# Default result folders from `panda run`.
*-SANITISED/
*-SANITISED-*/

# Python, packaging and virtual environments.
__pycache__/
*.py[cod]
/.venv/
/.venv-*/
/build/
/dist/
*.egg-info/

# Local tool state.
.pytest_cache/
.ruff_cache/

# Generated: synthetic corpora (tests/fixtures/*/generate.py) and the SBOM
# (scripts/generate_sbom.py).
/tests/fixtures/realistic/corpus/
/tests/fixtures/holdout/corpus/
/tests/fixtures/blind/corpus/
/sbom.spdx.json
